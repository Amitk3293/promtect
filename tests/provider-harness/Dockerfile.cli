FROM rust:1.96.0-slim-bookworm@sha256:4732ca96fd086cb9be682050c3f0176288eebaac2b80aa2bcefccfaf198e1950 AS promtect-builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
RUN mkdir src \
 && echo 'fn main() {}' > src/main.rs \
 && touch src/lib.rs \
 && cargo build --release --bin promtect \
 && rm -rf src
COPY src ./src
COPY assets ./assets
RUN touch src/main.rs src/lib.rs && cargo build --release --bin promtect

FROM node:22.23.1-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf

ARG TARGETARCH
ARG OLLAMA_VERSION=0.31.2
ARG AIDER_VERSION=0.86.2
ARG OLLAMA_AMD64_SHA256=2c88f0f31a959bac5a3cad4cc5296ec568551d4aa79f548f554adb2b575b3133
ARG OLLAMA_ARM64_SHA256=07a0adfcf3ed48ff110e2a3bcec897ca4d3f77d6f817d6ff63e83debfd102a31

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/usr/local/bin:/opt/provider-clis/node_modules/.bin:${PATH}

COPY tests/provider-harness/package.json tests/provider-harness/package-lock.json /opt/provider-clis/
COPY tests/provider-harness/requirements.lock /tmp/requirements.lock

RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl git python3 python3-pip zstd \
 && rm -rf /var/lib/apt/lists/* \
 && npm ci --prefix /opt/provider-clis --omit=dev \
 && grep --extended-regexp "^aider-chat==${AIDER_VERSION}[[:space:]]*\\\\$" /tmp/requirements.lock \
 && pip3 install --break-system-packages --only-binary=:all: --require-hashes --requirement /tmp/requirements.lock \
 && case "${TARGETARCH}" in \
      amd64) ollama_arch=amd64; ollama_sha256="${OLLAMA_AMD64_SHA256}" ;; \
      arm64) ollama_arch=arm64; ollama_sha256="${OLLAMA_ARM64_SHA256}" ;; \
      *) echo "unsupported Docker architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl --fail --silent --show-error --location \
      --output /tmp/ollama.tar.zst \
      "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-${ollama_arch}.tar.zst" \
 && echo "${ollama_sha256}  /tmp/ollama.tar.zst" | sha256sum --check --strict \
 && tar --zstd --extract --file /tmp/ollama.tar.zst --directory /usr bin/ollama \
 && rm /tmp/ollama.tar.zst /tmp/requirements.lock \
 && useradd --create-home --uid 10001 harness \
 && mkdir --parents /harness /synthetic \
 && chown -R harness:harness /harness /synthetic

WORKDIR /harness
COPY --from=promtect-builder /build/target/release/promtect /usr/local/bin/promtect
COPY tests/provider-harness/codex_observer.sh /usr/local/bin/codex
COPY tests/provider-harness/claude_observer.sh /usr/local/bin/claude
COPY tests/provider-harness/mock_provider.py tests/provider-harness/run_protocols.py tests/provider-harness/verify_cli_observations.py tests/provider-harness/test_guard_job_control.py tests/provider-harness/run_clis.sh ./
RUN chmod 0755 /usr/local/bin/codex /usr/local/bin/claude

USER harness
WORKDIR /synthetic
